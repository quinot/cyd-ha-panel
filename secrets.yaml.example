# Copy this file to secrets.yaml and fill in your values.
# NEVER commit secrets.yaml to version control.

wifi_ssid: "YourNetworkName"
wifi_password: "YourWifiPassword"

# Home Assistant API password (set in HA ESPHome integration)
api_password: "your_api_password_here"

# OTA update password
ota_password: "your_ota_password_here"

# Fallback AP password (used when wifi connection fails)
ap_password: "cyd-fallback"
